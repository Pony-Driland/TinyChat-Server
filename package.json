{
    "name": "tiny-rpg-chat-server",
    "version": "1.0.0",
    "description": "Lightweight roleplay/RPG chat room server",
    "engines": {
        "node": ">=20.0.0"
    },
    "bin": {
        "tiny-rpg-chat-archive": "./build/chat-archive-cli.js"
    },
    "scripts": {
        "start": "npx babel-node src/server/index.js",
        "start:proxy": "npx babel-node src/proxy/index.js",
        "build": "node build/pkg/tiny-chat.js",
        "test": "node --test test/chat-archive-cli.test.mjs",
        "test:watch": "node --test --watch test/chat-archive-cli.test.mjs",
        "chat:export": "node build/chat-archive-cli.js export",
        "chat:import": "node build/chat-archive-cli.js import",
        "chat:rooms": "node build/chat-archive-cli.js rooms",
        "chat:chapters": "node build/chat-archive-cli.js chapters",
        "prettier": "prettier --write ./src/api/* && prettier --write ./src/proxy/* && prettier --write ./build/* && prettier --write ./temp/*"
    },
    "author": {
        "name": "JasminDreasond (Yasmin Seidel)",
        "email": "tiny@pony.house",
        "url": "https://github.com/JasminDreasond"
    },
    "dependencies": {
        "buffer": "^6.0.3",
        "events": "^3.3.0",
        "ini": "^5.0.0",
        "puddysql": "^1.0.0-beta-9",
        "socket.io": "^4.8.1",
        "socket.io-client": "^4.8.1",
        "tiny-essentials": "^1.28.19",
        "tiny-server-essentials": "^1.1.0"
    },
    "devDependencies": {
        "@babel/cli": "^7.28.3",
        "@babel/core": "^7.28.3",
        "@babel/node": "^7.28.0",
        "@babel/parser": "^7.28.3",
        "@babel/preset-env": "^7.28.3",
        "@babel/traverse": "^7.28.3",
        "@types/fs-extra": "^11.0.4",
        "@types/ini": "^4.1.1",
        "babel-preset-es2015": "^6.24.1",
        "esmify": "^2.1.1",
        "fs-extra": "^11.3.3",
        "nexe": "^5.0.0-beta.4",
        "prettier": "3.6.2"
    },
    "private": true
}
